# =============================================================================
# .env.example - Ejemplo de archivo de variables de entorno
# =============================================================================
#
# Este archivo es un EJEMPLO educativo. No se usa en la aplicación actual.
#
# En proyectos profesionales, .env permite:
# - Guardar secretos (contraseñas, API keys) fuera del código
# - Configuración diferente por entorno (desarrollo/producción)
# - Valores que NO se suben a Git (añadir .env a .gitignore)
#
# Para usarlo necesitarías:
# 1. Copiar a .env (sin .example)
# 2. Instalar: pip install python-dotenv
# 3. Modificar config.py para cargar las variables
#
# =============================================================================

# Entorno de ejecución
ENVIRONMENT=development
DEBUG=true

# Configuración de datos (sobrescribe config.py si se carga)
DATA_FOLDER=data

# Configuración CSV
CSV_DELIMITER=,
CSV_ENCODING=utf-8

# =============================================================================
# EJEMPLO: Secretos que NUNCA deben ir en el código
# =============================================================================
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/bikeparking
# API_KEY=sk-1234567890abcdef
# SECRET_KEY=mi-clave-super-secreta


