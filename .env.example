# =============================================================================
# Variables de entorno para BikeParking
# Copia este archivo como .env y completa los valores
# =============================================================================

# Entorno de ejecución (development, testing, production)
ENVIRONMENT=development

# Ruta base del proyecto (opcional - se calcula automáticamente)
# Descomenta y modifica solo si necesitas una ruta diferente
# BASE_DIR=C:/Repositorios/DALP_2526/ECPY_Proyecto_BikeParking_GX

# Configuración de rutas
SOURCE_FOLDER=src

# Configuración de datos
DATA_FOLDER=data

# Configuración de CSV
CSV_DELIMITER=;
CSV_ENCODING=utf-8

# Configuración de la aplicación
APP_NAME=BikeParking
APP_VERSION=1.0.0
DEBUG=true
